{
  "name": "visual-bookmark",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "description": "A local-first visual bookmark side panel for Google Chrome.",
  "scripts": {
    "dev": "wxt",
    "postinstall": "wxt prepare",
    "build": "wxt build && node scripts/sync-unpacked.mjs",
    "zip": "wxt zip",
    "check": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "dexie": "^4.0.11",
    "minisearch": "^7.1.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/chrome": "^0.1.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@wxt-dev/module-react": "^1.1.5",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4",
    "wxt": "^0.21.3"
  },
  "packageManager": "pnpm@11.19.0"
}
